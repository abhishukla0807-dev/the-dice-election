---
import { Image } from 'astro:assets';
import logoImage from '../../assets/images/ui/logo.png';
import { site } from '../../config/site.js';
import { matchups } from '../../data/matchups.js';
import { matchupHref } from '../../utils/routes.js';

const { currentSlug } = Astro.props;
---

<header class="site-header container">
  <div class="site-header__bar">
    <a class="site-header__brand" href="/" aria-label={`${site.name} Home`}>
      <Image
        src={logoImage}
        alt=""
        class="site-header__logo"
        width={40}
        height={24}
        loading="eager"
        decoding="async"
      />
      <span class="site-header__brand-text">{site.name}</span>
    </a>

    <p class="site-header__live" aria-label="Live round status">
      <span aria-hidden="true"></span>LIVE
    </p>
  </div>

  <nav class="site-header__nav" aria-label="Matchups">
    <ul>
      {matchups.map((m) => (
        <li>
          <a href={matchupHref(m)} aria-current={m.slug === currentSlug ? 'page' : undefined}>
            {m.navLabel}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  /* Mobile-first base styles (<640px) */
  .site-header {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding-block: 0.625rem 0.75rem;
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 44px;
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.125rem;
    font-weight: 800;
    letter-spacing: -0.015em;
    text-decoration: none;
    color: var(--color-ink);
    min-height: 44px;
  }

  .site-header__logo {
    width: auto;
    height: 1.625rem;
    object-fit: contain;
    display: block;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .site-header__brand:hover .site-header__logo {
    transform: rotate(-8deg) scale(1.08);
  }

  .site-header__nav {
    width: 100%;
  }

  .site-header__nav ul {
    display: flex;
    width: 100%;
    padding: 0.2rem;
    border-radius: var(--radius-pill);
    background: #e2e8f0;
    gap: 0.25rem;
  }

  .site-header__nav li {
    flex: 1;
    display: flex;
  }

  .site-header__nav a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 38px;
    padding: 0.35rem 0.625rem;
    border-radius: var(--radius-pill);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-ink-muted);
    text-align: center;
    white-space: nowrap;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .site-header__nav a:hover {
    color: var(--color-ink);
  }

  .site-header__nav a[aria-current='page'] {
    background: #ffffff;
    color: var(--color-ink);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
  }

  .site-header__live {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-pill);
    background: var(--color-live-bg);
    color: var(--color-live-ink);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.06em;
  }

  .site-header__live span {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--color-live-dot);
    box-shadow: 0 0 6px var(--color-live-dot);
    animation: live-dot-pulse 1.4s ease-in-out infinite;
  }

  @keyframes live-dot-pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.4;
      transform: scale(0.85);
    }
  }

  /* Tablet and Desktop Enhancement (>=640px) */
  @media (min-width: 640px) {
    .site-header {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-md);
      padding-block: 0.875rem;
    }

    .site-header__bar {
      width: auto;
      gap: var(--space-md);
    }

    .site-header__brand {
      font-size: 1.25rem;
    }

    .site-header__logo {
      height: 1.875rem;
    }

    .site-header__nav {
      width: auto;
    }

    .site-header__nav ul {
      width: auto;
      background: transparent;
      padding: 0;
      gap: 0.5rem;
    }

    .site-header__nav li {
      flex: none;
    }

    .site-header__nav a {
      width: auto;
      padding: 0.4rem 0.875rem;
      background: rgba(0, 0, 0, 0.04);
      font-size: 0.875rem;
    }

    .site-header__nav a[aria-current='page'] {
      background: #ffffff;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    }

    .site-header__live {
      padding: 0.35rem 0.75rem;
      font-size: 0.75rem;
    }
  }
</style>
