---
import { Image } from 'astro:assets';

const { src } = Astro.props;
---

<!-- Decorative, tiny and low priority so it never competes for LCP. -->
<div class="backdrop" aria-hidden="true">
  <Image
    src={src}
    alt=""
    width={640}
    quality={30}
    format="webp"
    loading="lazy"
    decoding="async"
    fetchpriority="low"
  />
</div>

<style>
  .backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  .backdrop :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    opacity: 0.12;
  }
</style>
